# ============================================
# WeeVoice - Environment Configuration
# PBX Extension Setup for Zadarma
# ============================================
# Copy this file to .env and fill in your actual values
# cp env.pbx.template .env

# ============================================
# Application Settings
# ============================================
APP_NAME=WeeVoice - Voice Agent SaaS
VERSION=1.0.0
DEBUG=True
API_V1_STR=/api/v1

# Base URLs - IMPORTANT for PBX webhooks
# BACKEND_URL must be publicly accessible (HTTPS) for Zadarma webhooks to work
# Use your production domain or ngrok/tunneling service for local development
BACKEND_URL=https://your-domain.com
# Or for local development with tunneling:
# BACKEND_URL=https://your-ngrok-url.ngrok.io
BASE_URL=https://your-domain.com
FRONTEND_URL=https://your-frontend-domain.com

# ============================================
# Security
# ============================================
SECRET_KEY=your-secret-key-here-change-in-production-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ============================================
# Database
# ============================================
# PostgreSQL (recommended for production)
DATABASE_URL=postgresql://user:password@localhost:5432/weevoice
# Or SQLite for development
# DATABASE_URL=sqlite:///./voiceagent.db

# ============================================
# Zadarma API Configuration - REQUIRED for PBX Extensions
# ============================================
# Get these from: https://zadarma.com/ru/support/api/
# 1. Go to Zadarma Dashboard
# 2. Navigate to: Settings → API
# 3. Copy your API Key and API Secret

# REQUIRED: Your Zadarma API Key
ZADARMA_API_KEY=your_zadarma_api_key_here

# REQUIRED: Your Zadarma API Secret (used for webhook signature verification)
# This is critical for PBX extension webhooks to work securely
ZADARMA_API_SECRET=your_zadarma_api_secret_here

# ============================================
# Zadarma PBX Extension Settings
# ============================================
# PBX extensions are automatically created when you assign a phone number to an agent
# The webhook URL is automatically set to: {BACKEND_URL}/api/v1/zadarma/webhook
# Make sure BACKEND_URL is publicly accessible!

# PBX Server Credentials (REQUIRED for PBX extension management)
# Get these from: Zadarma Dashboard → PBX → Settings
# If you see "Direct to SIP" in your number settings, you need these credentials
ZADARMA_PBX_SERVER=pbx.zadarma.com
ZADARMA_PBX_LOGIN=your_pbx_login_here
ZADARMA_PBX_PASSWORD=your_pbx_password_here

# Optional: PBX ID (if you have multiple PBX systems in your Zadarma account)
# Leave empty to use the default PBX system
# You can find your PBX ID in Zadarma Dashboard → PBX → Settings
ZADARMA_PBX_ID=

# Optional: If you want to use SIP instead of PBX extensions
# Leave empty to use PBX extensions (recommended)
# Note: SIP credentials are different from PBX - SIP is for direct SIP connections
ZADARMA_SIP_LOGIN=
ZADARMA_SIP_PASSWORD=
ZADARMA_SIP_SERVER=sip.zadarma.com

# Optional: Your main Zadarma phone number (for reference)
ZADARMA_PHONE_NUMBER=

# ============================================
# Google Gemini API (for voice AI)
# ============================================
# Get your API key from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-09-2025

# ============================================
# OpenAI (for call summarization)
# ============================================
# Optional: Used for generating call summaries
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_SUMMARY_MODEL=gpt-4o

# ============================================
# Email Configuration (SMTP)
# ============================================
SMTP_HOST=mail.weedoo.be
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
SMTP_USE_TLS=1
SMTP_FROM_EMAIL=voice@weedoo.be
SMTP_FROM_NAME=WeeVoice Agent

# ============================================
# Pricing Configuration
# ============================================
COST_PER_MINUTE=0.05
PHONE_NUMBER_MONTHLY_COST=4.99

# ============================================
# Audio Configuration
# ============================================
CHUNK_SIZE=2048
RECEIVE_SAMPLE_RATE=24000
SEND_SAMPLE_RATE=16000

# ============================================
# Storage Paths
# ============================================
CALL_RECORDINGS_PATH=./data/recordings
TRANSCRIPTS_PATH=./data/transcripts

# ============================================
# Server Configuration
# ============================================
HOST=0.0.0.0
PORT=8000

# ============================================
# PBX Extension Setup Instructions
# ============================================
# 
# 1. Set ZADARMA_API_KEY and ZADARMA_API_SECRET above
# 2. Set BACKEND_URL to your publicly accessible HTTPS URL
# 3. In Zadarma Dashboard:
#    - Go to: Settings → Integrations → API → Event Notifications
#    - Set "About PBX calls" webhook URL to: {BACKEND_URL}/api/v1/zadarma/webhook
#    - Set "About events" webhook URL to: {BACKEND_URL}/api/v1/zadarma/webhook
#    - Save the settings
# 4. When you assign a phone number to an agent in WeeVoice:
#    - A PBX extension will be automatically created (e.g., 2001, 2002, etc.)
#    - The extension will be configured to forward calls to your webhook
# 5. Test by calling your Zadarma phone number
#
# For local development:
# - Use ngrok: ngrok http 8000
# - Set BACKEND_URL=https://your-ngrok-url.ngrok.io
# - Update Zadarma webhook URLs with the ngrok URL
#
# ============================================

